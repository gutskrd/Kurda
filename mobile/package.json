{
  "name": "@kurda/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint App.tsx src && node ../scripts/check-hardcoded-english.mjs mobile && node scripts/generate-icon-paths.mjs --check && node scripts/check-surface-style.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "web": "expo start --web --port 8081"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@kurda/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.7",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~57.0.31",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2"
  },
  "main": "index.ts",
  "devDependencies": {
    "@types/react": "~19.2.18"
  }
}
