    "android": {
      "package": "app.hevalo.mobile",
      "playStoreUrl": "",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      ["expo-secure-store", { "faceIDPermission": false }],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hevalo accesses your photos only when you choose one for your profile picture or a meme/image post.",
          "cameraPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Hevalo uses the microphone only when you record a voice note or complete a speaking exercise.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#b874f0",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9879cead-a0b7-4879-938f-8e69d96ec2b5"
