    "android": {
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#F9F9F8",
        "dark": {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0E1014"
        }
      },
      "package": "app.hevalo.mobile",
      "playStoreUrl": "",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hevalo accesses your photos only when you choose one for your profile picture, a group’s picture, a meme or an image post.",
          "cameraPermission": false,
          "microphonePermission": "Hevalo uses the microphone only when you record a voice note or complete a speaking exercise."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Hevalo uses the microphone only when you record a voice note or complete a speaking exercise.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#b874f0",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#F9F9F8",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E1014"
          }
        }
      ]
    ],
    "locales": {
      "ku": "./locales/ku.json",
      "ckb": "./locales/ckb.json",
