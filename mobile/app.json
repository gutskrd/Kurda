    "android": {
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FAF9FE",
        "dark": {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#141121"
        }
      },
      "package": "app.hevalo.mobile",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "playStoreUrl": "",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hevalo uploads the photos you choose as your profile picture, a group’s picture, a meme or a post.",
          "cameraPermission": false,
          "microphonePermission": "Hevalo records your voice when you tap record, to post a voice note or to play your speaking exercise back to you."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Hevalo records your voice when you tap record, to post a voice note or to play your speaking exercise back to you.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Hevalo reads how you tilt and turn your phone so that the deer on the screen moves with you, and keeps none of it."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#b874f0",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#FAF9FE",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#141121"
          }
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "LetterWidget",
              "label": "@string/letter_widget_name",
              "description": "@string/letter_widget_description",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetCategory": "home_screen",
              "previewImage": "./assets/widget/letter-preview.png"
            }
          ]
        }
      ],
      "./plugins/withLetterWidgetStrings.cjs"
    ],
    "locales": {
      "ku": "./locales/ku.json",
      "ckb": "./locales/ckb.json",
      "en": "./locales/en.json",
      "nl": "./locales/nl.json",
      "de": "./locales/de.json",
