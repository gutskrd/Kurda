{
  "name": "@kurda/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create --migration-file-language js",
    "db:seed": "tsx scripts/seed.ts",
    "seed:cosmetics": "tsx scripts/seed-cosmetics.ts",
    "cosmetics:upload": "tsx scripts/upload-cosmetics.ts",
    "content:import": "tsx scripts/import-content.ts",
    "dict:import": "tsx scripts/import-lexicon.ts",
    "events:seed": "tsx scripts/seed-events.ts",
    "worker": "tsx src/workers/main.ts",
    "dev:db": "node scripts/dev-db.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.0",
    "@kurda/shared": "*",
    "@sentry/node": "^10.70.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.2.0",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "pino-pretty": "^13.1.3"
  }
}
