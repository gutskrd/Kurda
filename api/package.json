{
  "name": "@kurda/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create --migration-file-language js",
    "db:seed": "tsx scripts/seed.ts",
    "seed:cosmetics": "tsx scripts/seed-cosmetics.ts",
    "email:art": "tsx scripts/generate-email-art.ts",
    "invite:art": "tsx scripts/generate-invite-art.ts",
    "share:art": "tsx scripts/generate-share-art.ts",
    "content:import": "tsx scripts/import-content.ts",
    "stories:import": "tsx scripts/import-stories.ts",
    "dict:import": "tsx scripts/import-lexicon.ts",
    "events:seed": "tsx scripts/seed-events.ts",
    "worker": "tsx src/workers/main.ts",
    "dev:db": "node scripts/dev-db.mjs",
    "book:export": "tsx scripts/book-export.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/literata": "^0.4.3",
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.0",
    "@kurda/shared": "*",
    "@sentry/node": "^10.69.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.0.7",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.7",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.2.1",
    "openskill": "^5.0.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "svg-to-pdfkit": "^0.1.8",
    "tsx": "^4.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.20.3",
    "@types/ws": "^8.18.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "pino-pretty": "^13.1.3"
  }
