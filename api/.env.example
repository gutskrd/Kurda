# Copy to .env (or export) for local development. See README for local Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kurda
# PORT=3000
# LOG_LEVEL=debug

# Which proxies may say who is asking (req.ip). Behind a proxy, name it or
# every caller shares one rate-limit bucket; false when nothing is in front.
# A bare hop count is refused — fastify 5.12.5 made it a no-op. See DEPLOY.md.
# TRUST_PROXY=loopback,linklocal,uniquelocal

# --- Social sign-in (KUR-276) ---
# Comma-separated allowed token audiences. The /auth/oauth verifier rejects a
# provider token whose `aud` isn't listed here. For native Sign in with Apple
# the audience is the app's bundle identifier.
APPLE_CLIENT_IDS=app.hevalo.mobile
# GOOGLE_CLIENT_IDS=<your-google-oauth-client-id>.apps.googleusercontent.com
# Sign in with Apple's key: deleting an account revokes its Apple tokens (App
# Store guideline 5.1.1(v)). Unset = nothing exchanged or revoked. See
# docs/auth/apple-signin.md. The private key is the .p8 file's text; on one
# line, write \n for each line break.
# APPLE_TEAM_ID=ABCDE12345
# APPLE_KEY_ID=FGHIJ67890
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_CLIENT_ID=app.hevalo.mobile   # optional; defaults to the first APPLE_CLIENT_IDS entry

# --- Transactional email (KUR-098) ---
# Pick ONE provider; unset = no delivery (stub logs sends). See
# docs/auth/email-delivery.md. EMAIL_FROM must be on a verified domain.
# Resend (HTTP API):
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Hevalo <no-reply@yourdomain>
# Or SMTP (SES / Postmark / Mailgun / Gmail / …):
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM=Hevalo <no-reply@yourdomain>
# Where answers to those emails go (unset: to the no-reply address, lost):
# EMAIL_REPLY_TO=support@yourdomain
# The support inbox in the admin panel (Resend receiving; see the doc above):
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
# RESEND_INBOX_API_KEY=re_xxxxxxxx   # full access: reads received mail's bodies
# SUPPORT_EMAIL_FROM=Hevalo Support <support@yourdomain>
# Where the admin panel lives, for the link in the urgent-report email to
# moderators (without it the email names the page instead of linking it):
# ADMIN_BASE_URL=https://admin.yourdomain
