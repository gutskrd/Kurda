# Copy to .env (or export) for local development. See README for local Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kurda
# PORT=3000
# LOG_LEVEL=debug

# --- Social sign-in (KUR-276) ---
# Comma-separated allowed token audiences. The /auth/oauth verifier rejects a
# provider token whose `aud` isn't listed here. For native Sign in with Apple
# the audience is the app's bundle identifier.
APPLE_CLIENT_IDS=app.kurda.mobile
# GOOGLE_CLIENT_IDS=<your-google-oauth-client-id>.apps.googleusercontent.com
