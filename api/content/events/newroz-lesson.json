                { "position": 4, "type": "multiple_choice", "payload": { "prompt": "\"Newroz\" tê çi wateyê?", "options": ["Roja nû (the new day)", "Şeva dirêj (long night)", "Havîn (summer)"], "correctIndex": 0 } }
              ]
