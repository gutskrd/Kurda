{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "-w", "web", "dev"],
      "port": 5174
    },
    {
      "name": "api",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "--env-file-if-exists=api/.env", "api/src/server.ts"],
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "-w", "admin", "dev"],
      "port": 5173
    },
    {
      "name": "admin-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--workspace", "admin", "--", "--port", "4173", "--strictPort"],
      "port": 4173
    }
  ]
}
