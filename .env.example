# Values here are substituted into docker-compose.yml (`docker compose up`).
# Copy to `.env` (gitignored) and fill in. Docker Compose auto-reads this file.
#
# Transactional email (KUR-098) — pick ONE provider; unset = no delivery (stub).
# EMAIL_FROM must be on a domain you've verified with the provider.
# See docs/auth/email-delivery.md.

# Resend (HTTP API):
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=MyKurda <no-reply@yourdomain>

# Or SMTP (Amazon SES / Postmark / Mailgun / Gmail / …):
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM=MyKurda <no-reply@yourdomain>
